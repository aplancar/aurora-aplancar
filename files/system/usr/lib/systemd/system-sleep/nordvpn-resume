#!/usr/bin/bash
#
# NordLynx (NordVPN's WireGuard backend) keeps stale routes/socket state
# across suspend and silently blackholes traffic until the tunnel is torn
# down and rebuilt. systemd-logind runs every executable in this directory
# automatically on sleep/resume — no unit needs to be enabled.
#
# Record whether we were connected on "pre" (while everything is still up).
# On "post", hand off to a background "reconnect" run: NetworkManager only
# brings Wi-Fi back after logind's sleep job (and so this hook) finishes,
# so waiting for the network inside the hook can never succeed — and a
# connect attempt with no network picks a random server and leaves a dead
# tunnel. The background run waits for the network, gives nordvpnd's own
# post-resume reconnect a chance, and only bounces the tunnel if traffic
# through it still fails.

set -uo pipefail

# The nordvpn CLI dies with "cannot get user home dir" when $HOME is unset,
# which it is under systemd-sleep — without this every call below fails and
# "pre" always concludes we weren't connected.
export HOME="${HOME:-/root}"

ACTION="${1:-}"
STAGE="${2:-}"

STATE_FILE="/run/nordvpn-resume.was-connected"

log() {
    echo "nordvpn-resume: $*"
}

case "$STAGE" in
    suspend|hibernate|hybrid-sleep|suspend-then-hibernate) ;;
    *) exit 0 ;;
esac

if [ "$ACTION" = "pre" ]; then
    rm -f "$STATE_FILE"

    command -v nordvpn >/dev/null 2>&1 || exit 0
    systemctl is-active --quiet nordvpnd.service || exit 0

    STATUS_OUTPUT="$(nordvpn status 2>/dev/null)" || exit 0
    if grep -qi "^Status: Connected" <<<"$STATUS_OUTPUT"; then
        touch "$STATE_FILE"
    fi
    exit 0
fi

if [ "$ACTION" = "post" ]; then
    if [ ! -e "$STATE_FILE" ]; then
        log "was not connected before suspend, nothing to do"
        exit 0
    fi
    rm -f "$STATE_FILE"

    # systemd-sleep keeps user.slice frozen until every hook exits, so the
    # waits and reconnect below would freeze the desktop for ~45s after
    # resume. Hand them to a transient unit and return immediately.
    systemd-run --no-block --collect --quiet --unit=nordvpn-resume-reconnect \
        "$0" reconnect "$STAGE" \
        || log "failed to start background reconnect"
    exit 0
fi

[ "$ACTION" = "reconnect" ] || exit 0

if ! command -v nordvpn >/dev/null 2>&1; then
    log "nordvpn CLI not found, skipping"
    exit 0
fi

# Wait for NetworkManager to bring the physical link back (main table only;
# NordVPN's default route lives in table 205).
for _ in $(seq 1 90); do
    ip route show default 2>/dev/null | grep -q . && break
    sleep 1
done

if ! ip route show default 2>/dev/null | grep -q .; then
    log "no network after resume, skipping"
    exit 0
fi

if ! systemctl is-active --quiet nordvpnd.service; then
    log "nordvpnd.service is not active, skipping"
    exit 0
fi

# nordvpnd reconnects on its own after resume; give it time, then check
# whether traffic actually flows before tearing anything down.
tunnel_works() {
    grep -qi "^Status: Connected" <<<"$(nordvpn status 2>&1)" \
        && ping -c1 -W3 1.1.1.1 >/dev/null 2>&1
}

for _ in $(seq 1 20); do
    if tunnel_works; then
        log "tunnel is working after resume, nothing to do"
        exit 0
    fi
    sleep 1
done

log "tunnel not passing traffic, reconnecting NordVPN"

if ! OUT="$(nordvpn disconnect 2>&1)"; then
    log "disconnect failed: $OUT"
    exit 0
fi

sleep 1

if ! OUT="$(nordvpn connect 2>&1)"; then
    log "reconnect failed: $OUT"
    exit 0
fi

log "reconnected successfully"
exit 0
